# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
OPENAI_API_KEY=sk-...

# Optional: Qdrant Cloud (nếu không dùng Docker local).
# Để trống nếu chạy Qdrant local qua `docker compose up -d`.
QDRANT_URL=https://xxxxxxxx.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key